    "gray": "#928372",
    "brightBlack": "#928372",
    "brightRed": "#fb4934",
    "brightGreen": "#b8bb26",
    "brightYellow": "#fabd2f",
    "brightBlue": "#83a598",
    "brightPurple": "#d3869b",
    "brightAqua": "#8ec07c",
    "brightOrange": "#fe8019",
    "bg0": "#282828",
    "bg1": "#3c3836",
    "bg2": "#504945",
    "bg3": "#665c54",
    "bg4": "#7c6f64",
    "fg0": "#fbf1c7",
